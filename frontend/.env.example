# true: src/mocks 의 목 데이터를 사용해요 / false: 실제 백엔드 API를 호출해요
VITE_USE_MOCK=true
# 실제 백엔드 주소 (예: http://localhost:8000). 비워두면 같은 도메인(Nginx 프록시)으로 요청해요
VITE_API_BASE_URL=
# true: 광고 자리(AdSlot)를 보여줘요 / 기본값 false
VITE_SHOW_ADS=false
# true: 메인에 "떠오르는 기업"을 보여줘요 / 기본값 false (선정 기준이 정해질 때까지 숨김)
VITE_FEATURE_RISING_COMPANIES=false
